{
	Tools = ordered() {
		TextBg = Background {
			Inputs = {
				UseFrameFormatSettings = Input { Value = 1, },
				Type = Input { Value = 0, },
				TopLeftRed   = Input { Value = 0, },
				TopLeftGreen = Input { Value = 0, },
				TopLeftBlue  = Input { Value = 0, },
				TopLeftAlpha = Input { Value = 0.72, },
			},
		},
		BgXform = Transform {
			Inputs = {
				Input = Input { SourceOp = "TextBg", Source = "Output", },
				Center = Input { Value = { 0.5, 0.5 }, },
				Size   = Input { Value = 1, },
				Aspect = Input { Value = 5, },
			},
		},
		BoxText = TextPlus {
			Inputs = {
				UseFrameFormatSettings = Input { Value = 1, },
				StyledText = Input { Value = "Your text on a dark card", },
				Font = Input { Value = "Open Sans", },
				Style = Input { Value = "Regular", },
				Size = Input { Value = 0.055, },
				HorizontalAnchor = Input { Value = 0.5, },
				VerticalAnchor = Input { Value = 0.5, },
				Center = Input { Value = { 0.5, 0.5 }, },
				Red1 = Input { Value = 1, },
				Green1 = Input { Value = 1, },
				Blue1 = Input { Value = 1, },
			},
		},
		MergeBox = Merge {
			Inputs = {
				Background = Input { SourceOp = "BgXform", Source = "Output", },
				Foreground = Input { SourceOp = "BoxText", Source = "Output", },
				PerformDepthMerge = Input { Value = 0, },
			},
		},
		MediaOut1 = MediaOut {
			Inputs = {
				Input = Input { SourceOp = "MergeBox", Source = "Output", },
			},
		},
	},
	ActiveTool = "MediaOut1",
}
