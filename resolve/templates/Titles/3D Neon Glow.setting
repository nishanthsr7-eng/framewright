{
	Tools = ordered() {
		CoreText = TextPlus {
			Inputs = {
				UseFrameFormatSettings = Input { Value = 1, },
				StyledText = Input { Value = "NEON", },
				Font = Input { Value = "Open Sans", },
				Style = Input { Value = "Black", },
				Size = Input { Value = 0.12, },
				HorizontalAnchor = Input { Value = 0.5, },
				VerticalAnchor = Input { Value = 0.5, },
				Center = Input { Value = { 0.5, 0.5 }, },
				Red1 = Input { Value = 1, },
				Green1 = Input { Value = 1, },
				Blue1 = Input { Value = 1, },
			},
		},
		ColoredText = ColorCorrector {
			Inputs = {
				Input = Input { SourceOp = "CoreText", Source = "Output", },
				ShadowsR = Input { Value = 0, },
				ShadowsG = Input { Value = 0, },
				ShadowsB = Input { Value = 0, },
				MidtonesR = Input { Value = -0.3, },
				MidtonesG = Input { Value = 0.1, },
				MidtonesB = Input { Value = 0.4, },
			},
		},
		GlowOuter = Blur {
			Inputs = {
				XBlurSize = Input { Value = 35, },
				Input = Input { SourceOp = "ColoredText", Source = "Output", },
			},
		},
		GlowInner = Blur {
			Inputs = {
				XBlurSize = Input { Value = 10, },
				Input = Input { SourceOp = "ColoredText", Source = "Output", },
			},
		},
		MergeOuter = Merge {
			Inputs = {
				Background = Input { SourceOp = "GlowOuter", Source = "Output", },
				Foreground = Input { SourceOp = "GlowInner", Source = "Output", },
				ApplyMode = Input { Value = "Screen", },
				PerformDepthMerge = Input { Value = 0, },
			},
		},
		MergeCore = Merge {
			Inputs = {
				Background = Input { SourceOp = "MergeOuter", Source = "Output", },
				Foreground = Input { SourceOp = "CoreText", Source = "Output", },
				PerformDepthMerge = Input { Value = 0, },
			},
		},
		MediaOut1 = MediaOut {
			Inputs = {
				Input = Input { SourceOp = "MergeCore", Source = "Output", },
			},
		},
	},
	ActiveTool = "MediaOut1",
}
