			},
		},
		Merge1 = Merge {
			Inputs = {
				Background = Input { SourceOp = "DissolveOut", Source = "Output", },
				Foreground = Input { SourceOp = "DissolveIn", Source = "Output", },
				PerformDepthMerge = Input { Value = 0, },
			},
		},
		MediaOut1 = MediaOut {
			Inputs = {
				Input = Input { SourceOp = "Merge1", Source = "Output", },
			},
		},
	},
	ActiveTool = "MediaOut1",
}
