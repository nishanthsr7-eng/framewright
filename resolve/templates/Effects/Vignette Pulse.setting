{
	Tools = ordered() {
		MediaIn1 = MediaIn { Inputs = { GlobalIn = Input { Value = 0, }, }, },
		VigMask = EllipseMask {
			Inputs = {
				Width    = Input { SourceOp = "PulseSpline", Source = "Value", },
				Height   = Input { SourceOp = "PulseSpline", Source = "Value", },
				SoftEdge = Input { Value = 0.6, },
			},
		},
		PulseSpline = BezierSpline {
			KeyFrames = {
				[0]  = { 0.72, },
				[12] = { 0.62, },
				[24] = { 0.72, },
				[36] = { 0.62, },
				[48] = { 0.72, },
			},
		},
		VigMatte = MatteControl {
			Inputs = {
				Input = Input { SourceOp = "MediaIn1", Source = "Output", },
				Mask  = Input { SourceOp = "VigMask",  Source = "Mask", },
				Invert = Input { Value = 1, },
			},
		},
		DarkBg = Background {
			Inputs = {
				UseFrameFormatSettings = Input { Value = 1, },
				TopLeftRed   = Input { Value = 0, },
				TopLeftGreen = Input { Value = 0, },
				TopLeftBlue  = Input { Value = 0, },
				TopLeftAlpha = Input { Value = 0.75, },
			},
		},
		VigApply = Merge {
			Inputs = {
				Background = Input { SourceOp = "MediaIn1", Source = "Output", },
				Foreground = Input { SourceOp = "DarkBg",   Source = "Output", },
				Mask       = Input { SourceOp = "VigMatte", Source = "Mask", },
				PerformDepthMerge = Input { Value = 0, },
			},
		},
		MediaOut1 = MediaOut {
			Inputs = {
				Input = Input { SourceOp = "VigApply", Source = "Output", },
			},
		},
	},
	ActiveTool = "MediaOut1",
}
