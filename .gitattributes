# Normalize text to LF in the repo; keep binaries untouched.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.onnx binary
*.ttf binary
*.otf binary
*.drp binary
*.zip binary
