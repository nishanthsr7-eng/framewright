# LLM endpoints for evals/agent eval. Copy to .env and fill in what you use; leave the rest empty.
# Any OpenAI-compatible endpoint works (hosted APIs, Ollama, LM Studio, vLLM).

# Model A
LLM_A_BASE_URL=
LLM_A_API_KEY=
LLM_A_MODEL=

# Model B
LLM_B_BASE_URL=
LLM_B_API_KEY=
LLM_B_MODEL=

# Local servers usually need no key, e.g. Ollama: LLM_B_BASE_URL=http://localhost:11434/v1
